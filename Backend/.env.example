# Copy this file to .env and fill it in.  NEVER commit or share your real .env.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Database ------------------------------------------------------------------
# Local development can keep postgres:postgres. On any shared or public machine, set a strong password:
#   sudo -u postgres psql -c "ALTER USER postgres PASSWORD 'a-long-random-password'"
# and put the same password here (production refuses to start with postgres:postgres).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicconnect
DB_POOL_MAX=10

# --- Secrets -------------------------------------------------------------------
# Make one with:  npm run gen:secret      (production needs 32+ random characters)
JWT_SECRET=paste-the-output-of-npm-run-gen-secret-here

# --- Uploads -------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
# Photos are re-encoded (GPS/EXIF data removed). New uploads are refused when this folder reaches this size.
MAX_UPLOAD_DIR_MB=2048

# --- Network / abuse limits ----------------------------------------------------
# 0 = no reverse proxy in front (default; X-Forwarded-For is ignored, so rate limits cannot be dodged).
# Set 1 only when exactly one proxy (nginx, a cloud load balancer) really sits in front of the API.
TRUST_PROXY=0
MAX_COMPLAINTS_PER_DAY=10
# true = refuse complaints whose GPS pin is far outside the chosen area (leave false while testing from other places)
GEOFENCE_COMPLAINTS=false

# --- Public addresses (used in the links inside emails) -------------------------
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# --- Email ----------------------------------------------------------------------
# Used for: password reset, confirming email addresses, worker approval. Full guide: ../EMAIL_SETUP.md
# Leave SMTP_HOST empty while developing: emails are then PRINTED in the API terminal instead of sent.
# Test your settings any time with:  npm run mail:test you@example.com
RESET_TOKEN_MINUTES=30
# Development only: when SMTP is not set up, the forgot-password page tells you to look in the API terminal.
DEV_MAIL_HINT=true
# Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#         SMTP_USER=you@gmail.com  SMTP_PASS=<16-character Google App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# For Gmail/Outlook this is replaced by SMTP_USER automatically (they refuse other sender addresses).
MAIL_FROM=CivicConnect <no-reply@civicconnect.local>

# --- Authority sign-up ----------------------------------------------------------
# PRODUCTION: leave this EMPTY and invite officers one by one:   npm run authority:invite -- --area Guntur
# (each code is single-use, tied to one area, and expires), or create accounts with:   npm run authority:create
# DEVELOPMENT ONLY: a shared code that anyone who knows it can use. The server refuses to start in production
# while it is still the public demo code.
AUTHORITY_INVITE_CODE=

# Reverse geocoding (GPS position -> street address) used by "Use current location". Defaults to OpenStreetMap's
# free Nominatim service, which asks for light use (the server caches results and sends a proper User-Agent).
# For a busy deployment point this at your own Nominatim or a commercial geocoder with the same response format.
# GEOCODER_URL=https://nominatim.openstreetmap.org/reverse

# --- Unassigned complaints ------------------------------------------------------------------------------------
# A complaint with no worker after this many hours triggers a reminder for the area's authorities (repeated at the same interval).
UNASSIGNED_ALERT_HOURS=4
REMINDER_CHECK_MINUTES=15
# Emergencies (flagged by the citizen) and severe complaints (AI severity 70% or more) are chased sooner than ordinary ones.
EMERGENCY_ALERT_HOURS=1
SEVERE_ALERT_HOURS=2
# An emergency task the worker has not started after this many hours reminds the worker and the authority.
EMERGENCY_WORKER_HOURS=2
# Misuse limits for the citizen's emergency flag: how many per day, and how many dismissed ones (last 30 days) switch it off for that citizen.
MAX_EMERGENCIES_PER_DAY=3
MAX_DISMISSED_EMERGENCIES=3
# Password guessing against ONE account from many addresses: after this many wrong passwords the account's sign-in pauses for the lock time
# ("Forgot password" still works). The per-address limit in routes/auth.js is separate.
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15
# Login lifetime. Officers see citizens' personal data, so theirs is shorter.
JWT_EXPIRES_AUTHORITY=8h
JWT_EXPIRES=7d
# The free OpenStreetMap address service asks for a contact address. For many users, point GEOCODER_URL at a paid / self-hosted Nominatim-compatible service.
GEOCODER_EMAIL=

# --- Photo check ----------------------------------------------------------------------------------------------
# A photo is always required, and one the on-device AI says does not show the chosen problem is always refused.
# true = also refuse photos the AI is merely unsure about (use this once you have trained your own model, see F11/public/models/civic).
PHOTO_CHECK_STRICT=false

# --- Village / town search (optional) --------------------------------------------------------------------------
# GEOCODER_SEARCH_URL=https://nominatim.openstreetmap.org/search
