VITE_API_URL=http://localhost:4000

# Optional: your own TensorFlow.js model for the "AI photo check" on the Report Issue page.
# Put the exported files (model.json, weights.bin, metadata.json) in F11/public/models/civic/ and set:
# VITE_CIVIC_MODEL_URL=/models/civic
# Without it the app uses the general-purpose MobileNet model. See F11/public/models/civic/README.md.

# Photo AI engine on the Report Issue page:
#   auto (default)  zero-shot model that understands "pile of garbage", "pothole", "broken street light" (about 90 MB, downloaded
#                   once, then cached) - used on phones/computers with 4 GB+ memory and no Data Saver; otherwise MobileNet.
#   clip            always the zero-shot model        mobilenet   never download it (smaller, much less accurate)
# VITE_AI_ENGINE=auto
