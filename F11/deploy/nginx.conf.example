# Static hosting of the built frontend (npm run build -> dist/) with security headers.
server {
  listen 443 ssl http2;
  server_name civic.example.com;
  root /var/www/civicconnect/dist;
  index index.html;

  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://api.example.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org; connect-src 'self' https://api.example.com https://huggingface.co https://*.huggingface.co https://hf.co https://*.hf.co https://cdn.jsdelivr.net https://storage.googleapis.com https://tfhub.dev https://www.kaggle.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=()" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location / { try_files $uri /index.html; }
  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
}
